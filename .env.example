# Masahati — env vars (do NOT commit real values)
# Copy to .env locally and fill in.

# Google OAuth (required for "Continue with Google")
VITE_GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

# Backend API base (default: https://masahati-backend.apps.taqat.academy)
VITE_API_URL=https://masahati-backend.apps.taqat.academy
