# Public backend URL (safe to expose to the browser)
VITE_API_URL=https://masahati-backend.apps.taqat.academy

# Real-time booking notifications (Pusher-compatible, e.g. Soketi).
# Leave VITE_PUSHER_APP_KEY empty to use the quiet /api/notifications polling fallback.
# Never put PUSHER_APP_SECRET here — it is server-side only.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=6001
VITE_PUSHER_SCHEME=http
VITE_PUSHER_CLUSTER=mt1
